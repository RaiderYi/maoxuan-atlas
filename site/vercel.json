{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "devCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/text.mjs": {
      "includeFiles": "data/texts.pack.json",
      "memory": 1024,
      "maxDuration": 10
    },
    "api/ask.mjs": {
      "includeFiles": "data/{sample-topic.json,topic-jgs.json}",
      "maxDuration": 60
    },
    "api/solve.mjs": {
      "includeFiles": "data/{sample-topic.json,topic-jgs.json}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/data/texts/:file",
      "destination": "/api/text?file=:file"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/data/data.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/data/texts.pack.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, must-revalidate" }
      ]
    }
  ]
}
